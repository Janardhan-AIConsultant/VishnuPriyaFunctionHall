# Frontend Configuration (Public runtime endpoints only - NEVER put secrets in VITE_* vars)
VITE_API_BASE_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_WHATSAPP_NUMBER=

# Backend Database & Cache (FastAPI - server-side only)
ENVIRONMENT=development
POSTGRES_DB=vishnupriya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/vishnupriya
REDIS_URL=redis://localhost:6379/0

# AI Chatbot (Grok xAI Primary + Optional Gemini Fallback - server-side only)
AI_PROVIDER=grok
XAI_API_KEY=
GROK_MODEL=grok-3
GEMINI_API_KEY=

# Payment Gateway (PhonePe PG, Google Pay / UPI & WhatsApp Pay - server-side .env only)
PAYMENT_MERCHANT_PHONE=
PAYMENT_MERCHANT_UPI_ID=
PAYMENT_MERCHANT_NAME=Vishnu Priya Function Hall
PAYMENT_DEFAULT_ADVANCE_INR=15000
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# Google Calendar Integration (Asia/Kolkata - server-side only)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Meta WhatsApp Business Cloud API & Public Contact Number (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CONTACT_NUMBER=

# Security & CORS (server-side only)
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_URL=http://localhost:3000
